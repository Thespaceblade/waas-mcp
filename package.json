{
  "name": "waas-mcp",
  "version": "0.2.2",
  "description": "MCP server for browsing and applying to YC Work at a Startup jobs (workatastartup.com)",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Thespaceblade/waas-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Thespaceblade/waas-mcp/issues"
  },
  "homepage": "https://github.com/Thespaceblade/waas-mcp#readme",
  "bin": {
    "waas-mcp": "./dist/index.js",
    "waas-mcp-login": "./dist/login.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "postinstall": "playwright install chromium",
    "start": "node dist/index.js",
    "login": "npm run build && node dist/login.js",
    "test": "npm run build && node --test 'dist/**/*.test.js'",
    "test:live": "npx tsx src/scripts/integration-test.ts",
    "pack:mcpb": "npm run build && npx -y @anthropic-ai/mcpb@latest validate manifest.json && npx -y @anthropic-ai/mcpb@latest pack . waas-mcp.mcpb"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "node-html-parser": "^6.1.13",
    "playwright": "^1.62.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
